# Copie este arquivo para .env e preencha.

# Provedor de LLM: anthropic | openai | mock (offline, sem chave, para testes)
LLM_PROVIDER=anthropic

# Chaves de API (só a do provedor escolhido é necessária)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelo (opcional). Padrões: anthropic=claude-sonnet-5-5, openai=gpt-4o-mini
LLM_MODEL=

# Limite de tokens por resposta
LLM_MAX_TOKENS=400

# Quantas interações recentes o cérebro enxerga como contexto
MEMORY_MAX_INTERACTIONS=20

# Onde guardar a memória: sqlite (persiste entre sessões) | sessao (só em RAM)
MEMORY_BACKEND=sqlite
# Arquivo do banco SQLite (apague-o para o virt esquecer tudo)
MEMORY_DB_PATH=virt.db

# Orçamento aproximado de tokens do contexto (histórico mais antigo é cortado
# automaticamente acima disso, então MEMORY_MAX_INTERACTIONS alto não quebra nada)
CONTEXT_MAX_TOKENS=8000

# Memória de fatos: a cada N interações (e ao sair) o virt resume a conversa
# em fatos curtos ("o Lucas gosta de café") que ficam sempre no contexto
FACTS_REFLECT_EVERY=10
FACTS_MAX=30

# Arquivo com a personalidade do robô
PERSONALITY_FILE=personality.md

# DEBUG mostra tentativas e respostas inválidas do LLM
LOG_LEVEL=WARNING
